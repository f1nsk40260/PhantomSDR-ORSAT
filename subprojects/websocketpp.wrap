[wrap-git]
directory = websocketpp-0.8.2
url = https://github.com/zaphoyd/websocketpp.git
revision = develop
depth = 1
# Le meson.build de WrapDB (websocketpp_0.8.2-1) est fourni localement dans
# subprojects/packagefiles/websocketpp/ : la compilation ne dépend plus du
# serveur wrapdb.mesonbuild.com (souvent indisponible, erreur 504).
patch_directory = websocketpp

[provide]
websocketpp = websocketpp_dep
